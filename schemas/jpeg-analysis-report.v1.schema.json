{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unlabeled JPEG exploratory analysis line",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "byte_size", "sha256", "status", "reason", "pipeline_a", "pipeline_b", "quality"],
  "properties": {"name": {"type": "string", "minLength": 1}, "byte_size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"const": "EXCLUDED_PENDING_LABELS"}, "reason": {"enum": ["MISSING_INPUT", "CALIBRATION_UNAVAILABLE", "CORRUPT_INPUT"]}, "pipeline_a": {"type": "string", "minLength": 1}, "pipeline_b": {"type": "string", "minLength": 1}, "quality": {"type": "object", "additionalProperties": false, "required": ["saturation_ratio", "glare_ratio", "blur_score", "contrast_std", "masked_pixel_count"], "properties": {"saturation_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "glare_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "blur_score": {"type": "number", "minimum": 0}, "contrast_std": {"type": "number", "minimum": 0}, "masked_pixel_count": {"type": "integer", "minimum": 0}}}}
}
